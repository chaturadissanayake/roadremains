{
  "id": "w0_ballot_valid",
  "week": 0,
  "location": "polling_station",
  "background": "bg_polling_station",
  "portraits": {
    "left": "char_karunasena_happy",
    "right": null
  },
  "gauges_on_enter": {
    "ct": 10,
    "ih": 10,
    "vp": 20
  },
  "lines": [
    {
      "id": "w0_bv_01",
      "type": "narration",
      "text": "Fold. Box. Done. The ballot is in.",
      "advance": "click"
    },
    {
      "id": "w0_bv_02",
      "type": "narration",
      "text": "You walk out of the booth. Six weeks of Alupotha behind you. The presiding officer nods. The queue continues.",
      "advance": "click"
    }
  ],
  "on_complete": {
    "conditional": [
      {
        "condition": "flags.helpedElderlyWoman && flags.helpedNICYoungMan && flags.helpedLostCouple && flags.manifestoComparisonDone && flags.foundRoadFile && gauges.ct >= 75 && gauges.ih >= 75 && gauges.vp >= 75",
        "goto": "ending_good"
      },
      {
        "condition": "gauges.ct >= 60 && gauges.ih >= 60 && gauges.vp >= 60",
        "goto": "ending_good"
      },
      {
        "condition": "gauges.ct >= 30 && gauges.ih >= 30 && gauges.vp >= 30",
        "goto": "ending_neutral"
      },
      {
        "default": true,
        "goto": "ending_bad"
      }
    ]
  }
}